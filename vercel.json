{
  "version": 2,
  "builds": [
    {
      "src": "quiz_project/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "quiz_project/wsgi.py"
    }
  ],
  "env": {
    "DATABASE_URL": "postgresql://neondb_owner:npg_Esjfu8kSR9Kx@ep-morning-hat-ayib960a.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"
  }
}
